<?xml version="1.0" encoding="UTF-8"?>
<rendertheme xmlns="http://mapsforge.org/renderTheme" version="5" map-background="#242822" map-background-outside="#19211D">
    <rule e="way" k="natural" v="sea|issea"><area fill="#102E39"/></rule>
    <rule e="way" k="natural" v="land|nosea"><area fill="#242822"/></rule>
    <rule e="way" k="natural" v="sand|beach|dune"><area fill="#353126"/></rule>
    <rule e="way" k="natural" v="bare_rock|scree|rock"><area fill="#33312F"/></rule>
    <rule e="way" k="landuse" v="residential|commercial|retail" zoom-min="11"><area fill="#2B3030"/></rule>
    <rule e="way" k="landuse" v="industrial|railway|construction" zoom-min="12"><area fill="#313139"/></rule>
    <rule e="way" k="landuse|leisure|natural" v="park|garden|grass|meadow|orchard|farmland|wood|forest|nature_reserve"><area fill="#243B2D"/></rule>
    <rule e="way" k="natural|waterway|landuse" v="water|wetland|riverbank|reservoir|basin"><area fill="#174456"/></rule>
    <rule e="way" k="waterway" v="river|canal|wadi|stream|drain">
        <line stroke="#5697B2" stroke-width="0.8"/>
        <rule e="way" k="intermittent" v="yes"><line stroke="#A3BCD0" stroke-width="0.65" stroke-dasharray="4,3"/></rule>
        <rule e="way" k="*" v="*" zoom-min="13"><pathText k="name" font-size="11" fill="#E1E8D9" stroke="#14201B" stroke-width="2" repeat-gap="150"/></rule>
    </rule>
    <rule e="way" k="overview" v="land_border" zoom-max="8"><line stroke="#8B827C" stroke-width="1.0" stroke-linecap="butt" stroke-dasharray="5,4"/></rule>
    <rule e="way" k="admin_level" v="2"><line stroke="#988A92" stroke-width="0.9" stroke-dasharray="6,5"/></rule>
    <rule e="way" k="admin_level" v="4" zoom-min="9" zoom-max="14"><line stroke="#B7A8AA" stroke-width="0.65" stroke-dasharray="4,5"/></rule>
    <rule e="way" k="building" v="*" zoom-min="15"><area fill="#454647" stroke="#74716A" stroke-width="0.3"/></rule>
    <rule e="way" k="amenity|building" v="clinic|hospital" zoom-min="13"><area fill="#573B3B"/></rule>
    <rule e="way" k="aeroway" v="runway|taxiway"><line stroke="#ACB0B1" stroke-width="2.5"/></rule>
    <rule e="way" k="railway" v="rail|light_rail|subway" zoom-min="12"><line stroke="#8F8D96" stroke-dasharray="6,4" stroke-width="0.9"/></rule>
    <rule e="way" k="highway" v="path|footway|bridleway|track|steps|cycleway" zoom-min="13"><line stroke="#987E60" stroke-width="1.15" scale="none" stroke-linecap="butt" stroke-dasharray="3.5,3"/></rule>
    <rule e="way" k="highway" v="primary|trunk|motorway" zoom-max="9"><line stroke="#CA9D61" stroke-width="1.12"/></rule>
    <!-- Road casings precede the fills so junctions remain continuous. -->
    <rule e="way" k="highway" v="service|living_street|pedestrian" zoom-min="14"><line stroke="#373D3A" stroke-width="1.8"/></rule>
    <rule e="way" k="highway" v="residential|unclassified|road" zoom-min="12"><line stroke="#424640" stroke-width="2.15"/></rule>
    <rule e="way" k="highway" v="secondary|secondary_link|tertiary|tertiary_link" zoom-min="10"><line stroke="#514939" stroke-width="3.1"/></rule>
    <rule e="way" k="highway" v="primary|primary_link|trunk|trunk_link|motorway|motorway_link" zoom-min="10"><line stroke="#685036" stroke-width="3.8"/></rule>
    <rule e="way" k="highway" v="service|living_street|pedestrian" zoom-min="14"><line stroke="#777F77" stroke-width="1.35"/></rule>
    <rule e="way" k="highway" v="residential|unclassified|road" zoom-min="12"><line stroke="#8B948A" stroke-width="1.62"/></rule>
    <rule e="way" k="highway" v="secondary|secondary_link|tertiary|tertiary_link" zoom-min="10"><line stroke="#B5A682" stroke-width="2.45"/></rule>
    <rule e="way" k="highway" v="primary|primary_link|trunk|trunk_link|motorway|motorway_link" zoom-min="10"><line stroke="#D0A362" stroke-width="3.0"/></rule>
    <rule e="way" k="highway" v="secondary|tertiary|primary|trunk|motorway" zoom-min="10"><pathText k="ref" font-size="11" font-style="bold" fill="#E1E8D9" stroke="#14201B" stroke-width="2.5" priority="12" repeat-gap="150"/></rule>
    <rule e="way" k="highway" v="motorway|trunk|primary|secondary|tertiary" zoom-min="13"><pathText k="name" font-size="12" fill="#E1E8D9" stroke="#14201B" stroke-width="2" repeat-gap="160"/></rule>
    <rule e="way" k="highway" v="residential|unclassified|living_street|service" zoom-min="16"><pathText k="name" font-size="11" fill="#E1E8D9" stroke="#14201B" stroke-width="2" repeat-gap="140"/></rule>
    <rule e="node" k="place" v="country" zoom-max="8"><caption k="name" font-size="12" font-style="bold" fill="#E1E8D9" stroke="#14201B" stroke-width="2.6" priority="95"/></rule>
    <rule e="node" k="overview" v="major_centre" zoom-max="7"><caption k="name" font-size="13" font-style="bold" fill="#E1E8D9" stroke="#14201B" stroke-width="2.5" priority="90"/></rule>
    <rule e="node" k="overview" v="emirate_centre" zoom-max="7"><caption k="name" font-size="11" font-style="bold" fill="#E1E8D9" stroke="#14201B" stroke-width="2.5" priority="60"/></rule>
    <rule e="node" k="place" v="city" zoom-min="8"><caption k="name" font-size="16" font-style="bold" fill="#E1E8D9" stroke="#14201B" stroke-width="3.0" priority="80"/></rule>
    <rule e="node" k="place" v="town" zoom-min="8"><caption k="name" font-size="14" font-style="bold" fill="#E1E8D9" stroke="#14201B" stroke-width="2.8" priority="60"/></rule>
    <rule e="node" k="place" v="suburb|village|island" zoom-min="10"><caption k="name" font-size="13" fill="#E1E8D9" stroke="#14201B" stroke-width="2.7" priority="45"/></rule>
    <rule e="node" k="place" v="district|quarter|neighbourhood|hamlet|locality" zoom-min="13"><caption k="name" font-size="12" fill="#E1E8D9" stroke="#14201B" stroke-width="2.6" priority="35"/></rule>
    <rule e="node" k="natural" v="peak" zoom-min="12"><caption k="name" font-size="12" fill="#E1E8D9" stroke="#14201B" stroke-width="2.4" priority="26"/></rule>
    <rule e="any" k="amenity|healthcare" v="hospital|clinic" zoom-min="13">
        <symbol id="medical" src="assets:medical.svg" symbol-width="19" symbol-height="19" priority="54"/>
        <caption k="name" symbol-id="medical" position="right" font-size="12" fill="#E1E8D9" stroke="#14201B" stroke-width="2.6" priority="52"/>
    </rule>
    <rule e="any" k="amenity" v="police" zoom-min="14">
        <symbol id="police" src="assets:police.svg" symbol-width="18" symbol-height="18" priority="49"/>
        <caption k="name" symbol-id="police" position="right" font-size="11" fill="#E1E8D9" stroke="#14201B" stroke-width="2.4" priority="47"/>
    </rule>
    <rule e="any" k="amenity" v="fuel" zoom-min="14">
        <symbol id="fuel" src="assets:fuel.svg" symbol-width="18" symbol-height="18" priority="37"/>
        <rule e="any" k="*" v="*" zoom-min="16"><caption k="name" symbol-id="fuel" position="right" font-size="11" fill="#E1E8D9" stroke="#14201B" stroke-width="2.4" priority="35"/></rule>
    </rule>
    <rule e="any" k="amenity" v="pharmacy" zoom-min="15">
        <symbol id="pharmacy" src="assets:pharmacy.svg" symbol-width="17" symbol-height="17" priority="38"/>
        <rule e="any" k="*" v="*" zoom-min="16"><caption k="name" symbol-id="pharmacy" position="right" font-size="11" fill="#E1E8D9" stroke="#14201B" stroke-width="2.4" priority="36"/></rule>
    </rule>
</rendertheme>
